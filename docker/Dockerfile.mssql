# MSSQL with pangya.bak baked in. Restore runs on first boot from the image file.
FROM mcr.microsoft.com/mssql/server:2019-latest

USER root
COPY docker/assets/pangya.bak /opt/pangya/pangya.bak
COPY docker/mssql-entrypoint.sh /usr/local/bin/mssql-entrypoint.sh
RUN chmod 755 /usr/local/bin/mssql-entrypoint.sh \
	&& chmod 644 /opt/pangya/pangya.bak

USER mssql
ENV PANGYA_BAK=/opt/pangya/pangya.bak
ENTRYPOINT ["/bin/bash", "/usr/local/bin/mssql-entrypoint.sh"]
